# Copy to .env and fill. .env is gitignored.

# --- Postgres (docker-compose) ---
POSTGRES_USER=boleta
POSTGRES_PASSWORD=change_me
POSTGRES_DB=boletas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@local
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# --- OCR worker (host process) ---
OCR_HOST=0.0.0.0
OCR_PORT=8000
IMAGE_STORE=./data/images

# --- Telegram (openclaw already configured elsewhere; worker does not need the token) ---
# WORKER_URL the bot should POST to:
# http://localhost:8000/ocr   (worker as host process)
