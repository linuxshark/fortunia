# Copy to .env and fill. .env is gitignored.

# --- Postgres (docker-compose) ---
POSTGRES_USER=boleta
POSTGRES_PASSWORD=change_me
POSTGRES_DB=boletas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Dashboard web (capa de visualización, solo lectura) ---
DASHBOARD_PORT=8001
POSTGRES_RO_USER=fortunia_ro
POSTGRES_RO_PASSWORD=change_me_ro

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@local
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5050

# --- OCR worker (host process) ---
OCR_HOST=0.0.0.0
OCR_PORT=8002
IMAGE_STORE=./data/images

# --- Gemini Vision fallback (escalación automática si Tesseract < 65% confianza) ---
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Telegram (openclaw already configured elsewhere; worker does not need the token) ---
# WORKER_URL the bot should POST to:
# http://localhost:8000/ocr   (worker as host process)
